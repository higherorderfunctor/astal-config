{
  "name": "@astal-config/eslint-plugin",
  "version": "1.0.2",
  "description": "Astal Config ESLint Plugin",
  "private": true,
  "type": "module",
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "import": "./src/index.ts",
      "default": "./src/index.ts"
    }
  },
  "scripts": {
    "gen-airbnb-rules": "bun ./bin/gen-airbnb-rules.ts && (cd ../../.. && pnpm lint:fix packages/core/eslint-plugin/src/configs/airbnb.json)",
    "lint:tsc": "tsc -b tsconfig.json"
  },
  "dependencies": {
    "@cspell/eslint-plugin": "8.17.2",
    "@effect/platform": "0.73.1",
    "@effect/platform-bun": "0.53.1",
    "@eslint/compat": "1.2.5",
    "@eslint/eslintrc": "3.2.0",
    "@eslint/js": "9.18.0",
    "@stylistic/eslint-plugin": "2.13.0",
    "@types/debug": "^4.1.12",
    "@types/node": "22.10.6",
    "@typescript-eslint/eslint-plugin": "8.20.0",
    "@typescript-eslint/parser": "8.20.0",
    "@typescript-eslint/utils": "8.20.0",
    "cspell": "8.17.2",
    "debug": "4.4.0",
    "effect": "3.12.4",
    "eslint": "9.18.0",
    "eslint-config-airbnb-base": "15.0.0",
    "eslint-config-airbnb-typescript": "18.0.0",
    "eslint-config-prettier": "10.0.1",
    "eslint-import-resolver-typescript": "3.7.0",
    "eslint-plugin-codegen": "0.29.0",
    "eslint-plugin-functional": "8.0.0",
    "eslint-plugin-import-x": "4.6.1",
    "eslint-plugin-jsonc": "2.18.2",
    "eslint-plugin-markdown": "5.1.0",
    "eslint-plugin-perfectionist": "4.6.0",
    "eslint-plugin-prefer-arrow-functions": "3.6.2",
    "eslint-plugin-prettier": "5.2.1",
    "eslint-plugin-promise": "7.2.1",
    "eslint-plugin-security": "3.0.1",
    "eslint-plugin-simple-import-sort": "12.1.1",
    "eslint-plugin-sort-destructure-keys": "2.0.0",
    "eslint-plugin-tsdoc": "0.4.0",
    "eslint-plugin-unicorn": "56.0.1",
    "jsonc-eslint-parser": "2.4.0",
    "typescript": "5.7.3",
    "typescript-eslint": "8.20.0"
  },
  "devDependencies": {
    "@types/eslint": "9.6.1",
    "@types/eslint-config-airbnb-base": "link:../../vendor/@types/eslint-config-airbnb-base",
    "@types/eslint-config-airbnb-typescript": "link:../../vendor/@types/eslint-config-airbnb-typescript",
    "@types/eslint-plugin-import": "link:../../vendor/@types/eslint-plugin-import",
    "@types/eslint-plugin-markdown": "link:../../vendor/@types/eslint-plugin-markdown",
    "@types/eslint-plugin-promise": "link:../../vendor/@types/eslint-plugin-promise",
    "@types/eslint-plugin-security": "link:../../vendor/@types/eslint-plugin-security",
    "@types/eslint-plugin-sort-destructure-keys": "link:../../vendor/@types/eslint-plugin-sort-destructure-keys",
    "@types/eslint__eslintrc": "2.1.2",
    "@types/eslint__js": "8.42.3"
  }
}
