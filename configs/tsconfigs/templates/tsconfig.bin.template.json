{
  "$schema": "https://json.schemastore.org/tsconfig",
  "extends": ["../../../tsconfig.base.json"],
  "include": ["${configDir}/bin/**/*.ts", "${configDir}/package.json"],
  "compilerOptions": {
    "noEmit": true,
    "rootDir": "${configDir}",
    "tsBuildInfoFile": "${configDir}/.tsbuildinfo/bin.tsbuildinfo",
    "types": ["bun"]
  }
}
