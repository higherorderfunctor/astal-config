{
  "$schema": "https://json.schemastore.org/tsconfig",
  "extends": ["../../../tsconfig.base.json"],
  "include": ["${configDir}/src/**/*.ts", "${configDir}/src/**/*.tsx", "${configDir}/src/**/*.json"],
  "compilerOptions": {
    "noEmit": true,
    "rootDir": "${configDir}",
    "tsBuildInfoFile": "${configDir}/.tsbuildinfo/utils.tsbuildinfo",
    "types": ["bun"]
  }
}
