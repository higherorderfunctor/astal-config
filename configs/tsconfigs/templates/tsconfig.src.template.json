{
  "$schema": "https://json.schemastore.org/tsconfig",
  "extends": ["../../../tsconfig.base.json"],
  "include": ["${configDir}/src/**/*.ts", "${configDir}/src/**/*.tsx", "${configDir}/src/**/*.json"],
  "compilerOptions": {
    "outDir": "${configDir}/dist/src",
    "rootDir": "${configDir}",
    "tsBuildInfoFile": "${configDir}/.tsbuildinfo/src.tsbuildinfo",
    "types": ["bun"]
  }
}
